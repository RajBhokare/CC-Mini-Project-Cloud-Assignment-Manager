<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cloud Assignment Manager - Upload Assignment</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a href="/" class="brand">
        <div class="brand-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
          </svg>
        </div>
        <span>Cloud Assignment Manager</span>
      </a>
      
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">&#9776;</button>
      
      <ul class="nav-links" id="navLinks">
        <li><a href="/" class="nav-link">Dashboard</a></li>
        <li><a href="/assignments" class="nav-link">Assignments</a></li>
        <li><a href="/upload" class="nav-link active">Upload</a></li>
        <li><a href="/files" class="nav-link">My Files</a></li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="container">
    
    <!-- Page Header -->
    <header class="page-header" style="text-align: center; max-width: 680px; margin: 0 auto;">
      <h1 class="page-title">Upload Assignment</h1>
      <p class="page-subtitle">Submit your document for academic grading and cloud archiving</p>
    </header>

    <!-- Upload Card -->
    <div class="upload-card">

      <!-- Alerts -->
      <% if (errorMessage) { %>
        <div class="alert alert-danger">
          <div class="alert-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= errorMessage %></span>
          </div>
          <button class="alert-close">&times;</button>
        </div>
      <% } %>

      <form action="/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
        
        <!-- Student Name -->
        <div class="form-group">
          <label for="studentName" class="form-label">Student Name</label>
          <input 
            type="text" 
            id="studentName" 
            name="studentName" 
            class="form-control" 
            placeholder="e.g. Raj Bhokare" 
            value="Raj Bhokare" 
            required
          >
        </div>

        <!-- Assignment Selection -->
        <div class="form-group">
          <label for="assignmentId" class="form-label">Assignment</label>
          <select id="assignmentId" name="assignmentId" class="form-control" required>
            <option value="" disabled <%= !selectedAssignmentId ? 'selected' : '' %>>Select Assignment ▼</option>
            <% assignments.forEach(function(item) { %>
              <option 
                value="<%= item.id %>" 
                <%= selectedAssignmentId === item.id ? 'selected' : '' %>
              >
                <%= item.title %> (<%= item.subject %> - <%= item.deadline %>)
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Choose File Dropzone -->
        <div class="form-group">
          <label class="form-label">Choose File</label>
          <div class="file-dropzone" id="dropzone">
            <svg class="dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <div class="dropzone-text">Click to browse or drag and drop your file here</div>
            <div class="dropzone-subtext">Maximum file size: 10MB</div>
            
            <input 
              type="file" 
              id="assignmentFile" 
              name="assignmentFile" 
              accept=".pdf,.doc,.docx,.ppt,.pptx,.txt,.zip" 
              required
            >
          </div>

          <!-- Selected File Preview Badge -->
          <div class="file-selected-info" id="fileSelectedInfo">
            <span id="selectedFileName">No file chosen</span>
          </div>

          <!-- Supported Formats Note -->
          <div class="formats-note">
            <span>Supported formats:</span>
            <span class="format-pill">PDF</span>
            <span class="format-pill">DOC</span>
            <span class="format-pill">DOCX</span>
            <span class="format-pill">PPT</span>
            <span class="format-pill">PPTX</span>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload Assignment
        </button>

      </form>

      <!-- Clearly Visible AWS Future Integration Note -->
      <div class="aws-note-box">
        <div class="aws-note-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <div>
          <div class="aws-note-title">AWS Integration Coming Next</div>
          <div class="aws-note-desc">
            In the final cloud deployment, uploaded files will be stored securely in <strong>Amazon S3</strong> with server-side encryption and presigned URLs.
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div>© 2026 Cloud Assignment Manager • CC Mini Project</div>
      <div class="footer-cloud-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
        AWS Architecture Ready
      </div>
    </div>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
