# ================================================================
# Cloud Assignment Manager - Environment Configuration Template
# ================================================================
# Copy this file to .env on your server or local environment:
#   cp .env.example .env
#
# DO NOT commit your actual .env file or AWS secrets to GitHub.
# ================================================================

# Application Port
PORT=3000

# AWS Region where EC2 and S3 are deployed
AWS_REGION=eu-north-1

# Amazon S3 Bucket Name (Private bucket with Block Public Access enabled)
# Example: S3_BUCKET_NAME=cloud-assignment-manager-raj-2026
S3_BUCKET_NAME=

# NOTE ON AWS CREDENTIALS:
# On the Amazon EC2 instance with the "CloudAssignmentEC2Role" IAM role attached,
# AWS credentials are automatically provided by the EC2 Instance Metadata Service.
# NO AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY is required or should be set here.
